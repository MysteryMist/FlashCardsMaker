<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlashCardsMaker.DeckEditorView">
    <Border BackgroundColor="#1B1B1B" Stroke="{StaticResource PanelBorder}" StrokeThickness="1.5" StrokeShape="RoundRectangle 16" Padding="18">
        <VerticalStackLayout Spacing="18">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="3">
                    <Label Text="{Binding DeckName, StringFormat='EDITING: {0}'}" FontSize="22" FontAttributes="Bold" TextColor="#F28C28" />
                    <Label Text="Auto-numbered cards • edits save locally" FontSize="12" TextColor="#A3AAA4" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                    <Button Text="Duplicate" Command="{Binding DuplicateDeckCommand}" BackgroundColor="#3B5744" TextColor="#F5F5F5" />
                    <Button Text="Delete" Command="{Binding DeleteSelectedDeckCommand}" BackgroundColor="#462727" TextColor="#F5F5F5" />
                </HorizontalStackLayout>
            </Grid>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <Entry Placeholder="Deck name" Text="{Binding DeckName}" />
                <Picker Grid.Column="1" WidthRequest="95" ItemsSource="{Binding JlptLevels}" SelectedItem="{Binding DeckJlptLevel}" />
                <Picker Grid.Column="2" WidthRequest="130" ItemsSource="{Binding CardTypes}" SelectedItem="{Binding DeckCardType}" />
            </Grid>
            <VerticalStackLayout Spacing="8">
                <Label Text="PRINT SHEET SETTINGS" FontSize="11" FontAttributes="Bold" TextColor="#A9C6B7" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Picker Title="Paper size" ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding SelectedPaperSize}" />
                    <Picker Grid.Column="1" Title="Card grid" ItemsSource="{Binding GridLayoutLabels}" SelectedItem="{Binding SelectedGridLayoutLabel}" />
                    <Picker Grid.Column="2" Title="Paper orientation" ItemsSource="{Binding PaperOrientations}" SelectedItem="{Binding SelectedPaperOrientation}" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Picker Title="Duplex flip edge" ItemsSource="{Binding FlipEdges}" SelectedItem="{Binding SelectedFlipEdge}" />
                    <Picker Grid.Column="1" Title="Export format" ItemsSource="{Binding ExportFormatLabels}" SelectedItem="{Binding SelectedExportFormatLabel}" />
                </Grid>
                <Picker Title="Export sides" ItemsSource="{Binding ExportLayoutLabels}" SelectedItem="{Binding SelectedExportLayoutLabel}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Validate &amp; export print sheets" Command="{Binding ExportDeckCommand}" BackgroundColor="#1F6F50" TextColor="#F5F5F5" />
                    <Button Grid.Column="1" Text="Export deck data" Command="{Binding ExportDeckDataCommand}" BackgroundColor="{StaticResource AccentOrange}" TextColor="#121212" FontAttributes="Bold" />
                </Grid>
            </VerticalStackLayout>
            <Border BackgroundColor="#1B1B1B" Stroke="#718078" StrokeThickness="2.5" StrokeShape="RoundRectangle 12" Padding="12">
                <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Label Text="Cards" FontSize="17" FontAttributes="Bold" VerticalOptions="Center" />
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Entry Placeholder="Type Kanji here..." Text="{Binding NewCardFrontText}" FontSize="20" HeightRequest="54" HorizontalOptions="Fill" />
                        <Button Grid.Column="1" Text="Add front" Command="{Binding AddCardCommand}" BackgroundColor="#1F6F50" TextColor="#F5F5F5" />
                        <HorizontalStackLayout Grid.Column="2" Spacing="6">
                            <Button Text="View deck" IsVisible="{Binding IsCardListVisible}" Command="{Binding ToggleDeckViewCommand}" BackgroundColor="#254235" TextColor="#F5F5F5" Padding="10,6" FontSize="11" />
                            <Button Text="Back to cards" IsVisible="{Binding IsDeckViewVisible}" Command="{Binding ToggleDeckViewCommand}" BackgroundColor="#254235" TextColor="#F5F5F5" Padding="10,6" FontSize="11" />
                        </HorizontalStackLayout>
                    </Grid>
                </Grid>
                <ScrollView Orientation="Horizontal" HeightRequest="82" IsVisible="{Binding IsCardListVisible}">
                    <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Cards}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid WidthRequest="108" HeightRequest="82">
                                    <Border BackgroundColor="{Binding SelectionBackgroundColor}" Stroke="{Binding SelectionStroke}" StrokeThickness="{Binding SelectionStrokeThickness}" StrokeShape="RoundRectangle 10" Padding="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding Number, StringFormat='{}{0:000}'}" FontSize="10" TextColor="#A9C6B7" />
                                                <Label Grid.Column="1" Text="EDITING" IsVisible="{Binding IsSelected}" FontSize="8" FontAttributes="Bold" TextColor="#FF8C00" />
                                            </Grid>
                                            <Label Text="{Binding FrontText}" FontSize="17" FontAttributes="Bold" TextColor="{Binding SelectionTextColor}" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Button Text="" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCardCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderWidth="0" CornerRadius="10" Padding="0" MinimumHeightRequest="0" MinimumWidthRequest="0">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroupList>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal">
                                                        <VisualState.Setters>
                                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Setter Property="Scale" Value="1" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Property="BackgroundColor" Value="#1AFFFFFF" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed">
                                                        <VisualState.Setters>
                                                            <Setter Property="BackgroundColor" Value="#44F28C28" />
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Setter Property="Scale" Value="0.97" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateGroupList>
                                        </VisualStateManager.VisualStateGroups>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
                <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Start" AlignContent="Start" BindableLayout.ItemsSource="{Binding Cards}" IsVisible="{Binding IsDeckViewVisible}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid WidthRequest="320" Margin="0,0,10,10">
                                <Border BackgroundColor="#242824" Stroke="{Binding SelectionStroke}" StrokeThickness="{Binding SelectionStrokeThickness}" StrokeShape="RoundRectangle 12" Padding="10">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Number, StringFormat='{}{0:000}'}" FontSize="11" TextColor="#A9C6B7" />
                                            <Label Grid.Column="1" Text="{Binding Status}" FontSize="10" FontAttributes="Bold" TextColor="{Binding StatusColor}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Border BackgroundColor="#F5F5F5" Stroke="#9AA49D" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="8" MinimumHeightRequest="150">
                                                <Grid RowDefinitions="Auto,*">
                                                    <Label Text="FRONT" FontSize="9" FontAttributes="Bold" TextColor="#59645D" />
                                                    <Label Grid.Row="1" Text="{Binding FrontText}" FontFamily="MS Gothic" FontSize="28" FontAttributes="Bold" TextColor="#121212" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Grid.Column="1" BackgroundColor="#F5F5F5" Stroke="#9AA49D" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="8" MinimumHeightRequest="150">
                                                <VerticalStackLayout Spacing="5">
                                                    <Label Text="BACK" FontSize="9" FontAttributes="Bold" TextColor="#59645D" />
                                                    <Label Text="{Binding BackPreviewMeta}" FontSize="10" FontAttributes="Bold" TextColor="#C62828" />
                                                    <Label Text="{Binding Hiragana}" FontFamily="MS Gothic" FontSize="16" FontAttributes="Bold" TextColor="#C62828" />
                                                    <Label Text="{Binding BackPreviewMeanings}" FontSize="12" TextColor="#121212" LineBreakMode="WordWrap" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                                <Button Text="" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCardCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderWidth="0" CornerRadius="10" Padding="0" MinimumHeightRequest="0" MinimumWidthRequest="0">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroupList>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                                        <Setter Property="Opacity" Value="1" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="#14FFFFFF" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="#33F28C28" />
                                                        <Setter Property="Scale" Value="0.98" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </VisualStateManager.VisualStateGroups>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
                </VerticalStackLayout>
            </Border>
            <Grid IsVisible="{Binding IsCardEditorVisible}" ColumnDefinitions="*,*" ColumnSpacing="16">
                <VerticalStackLayout Spacing="12">
                    <Border BackgroundColor="#1B1B1B" Stroke="#718078" StrokeThickness="2.5" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Card details" FontSize="17" FontAttributes="Bold" />
                        <Button Grid.Column="1" Text="Remove card" Command="{Binding DeleteCardCommand}" BackgroundColor="#462727" TextColor="#F5F5F5" Padding="10,6" FontSize="11" />
                    </Grid>
                    <Entry Placeholder="Kanji / word" Text="{Binding FrontText}" />
                    <Entry Placeholder="Hiragana reading" Text="{Binding Hiragana}" />
                    <Grid IsVisible="{Binding IsVerbDeck}" ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Picker Title="Verb type" ItemsSource="{Binding VerbKinds}" SelectedItem="{Binding VerbKind}" />
                        <Picker Grid.Column="1" Title="Transitivity" ItemsSource="{Binding Transitivities}" SelectedItem="{Binding Transitivity}" />
                    </Grid>
                    <Picker IsVisible="{Binding IsAdverbDeck}" Title="Adverb classification" ItemsSource="{Binding AdverbClassifications}" SelectedItem="{Binding AdverbClassification}" />
                    <Picker IsVisible="{Binding IsNounDeck}" Title="Noun category" ItemsSource="{Binding NounCategories}" SelectedItem="{Binding NounCategory}" />
                    </VerticalStackLayout>
                    </Border>
                    <Border BackgroundColor="#1B1B1B" Stroke="#718078" StrokeThickness="2.5" StrokeShape="RoundRectangle 12" Padding="12">
                    <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Meanings" FontSize="15" FontAttributes="Bold" />
                        <Button Grid.Column="1" Text="＋ Meaning" Command="{Binding AddMeaningCommand}" BackgroundColor="#254235" TextColor="#F5F5F5" Padding="10,6" FontSize="11" />
                    </Grid>
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Meanings}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4" IsEnabled="{Binding CanEdit}">
                                    <Entry Placeholder="Meaning" Text="{Binding Text}" />
                                    <Button Grid.Column="1" Text="×" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteMeaningCommand}" CommandParameter="{Binding .}" BackgroundColor="#462727" TextColor="#F5F5F5" Padding="12,6" />
                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Button Text="{Binding PrimaryButtonLabel}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SetPrimaryMeaningCommand}" CommandParameter="{Binding .}" BackgroundColor="#303630" TextColor="#F5F5F5" Padding="8,4" FontSize="10" />
                                        <Picker Grid.Column="1" Title="Display style" ItemsSource="{Binding StyleOptions}" SelectedItem="{Binding StyleName, Mode=TwoWay}" FontSize="11" />
                                        <Label Grid.Column="2" Text="PRIMARY" IsVisible="{Binding IsPrimaryMeaning}" TextColor="#1F6F50" FontSize="9" VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding SaveStatus}" FontSize="10" TextColor="#A3AAA4" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Save card" Command="{Binding SaveCardEditsCommand}" BackgroundColor="{StaticResource AccentOrange}" TextColor="#121212" FontAttributes="Bold" Padding="14,8" />
                    </Grid>
                    </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Live print preview" FontSize="17" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding CardStatusLabel}" TextColor="{Binding CardStatusColor}" FontSize="11" FontAttributes="Bold" />
                    </Grid>
                    <Border BackgroundColor="#F5F5F5" Stroke="{Binding CardStatusColor}" StrokeThickness="3" StrokeShape="RoundRectangle 12" Padding="16" HeightRequest="180">
                        <Grid RowDefinitions="Auto,*">
                            <Label Text="{Binding CardDisplayNumber}" TextColor="#C62828" FontFamily="Times New Roman" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="End" />
                            <Label Grid.Row="1" FormattedText="{Binding FrontPreviewText}" TextColor="#121212" FontSize="62" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border BackgroundColor="#F5F5F5" Stroke="{Binding CardStatusColor}" StrokeThickness="3" StrokeShape="RoundRectangle 12" Padding="16" HeightRequest="220">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding BackPreviewMeta}" TextColor="{Binding BackPreviewMetaColor}" FontFamily="Times New Roman" FontSize="11" FontAttributes="Bold" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="{Binding BackPreviewNumber}" TextColor="#C62828" FontFamily="Times New Roman" FontSize="21" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding BackPreviewReading}" TextColor="#C62828" FontFamily="MS Gothic" FontSize="21" FontAttributes="Bold" />
                            </Grid>
                                <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Meanings}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                            <Border BackgroundColor="#F5F5F5" Stroke="{Binding PreviewBorderColor}" StrokeThickness="2" StrokeShape="RoundRectangle 10" Padding="4,2">
                                                <Label Text="{Binding Text, StringFormat='•  {0}'}" TextColor="#121212" FontFamily="Times New Roman" FontSize="{Binding PreviewFontSize}" FontAttributes="{Binding PreviewFontAttributes}" TextDecorations="{Binding PreviewTextDecorations}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
